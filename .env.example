# Obrigatória — URL base da API (em device físico use o IP da sua máquina na mesma rede).
# Exemplo: http://192.168.1.10:8080
EXPO_PUBLIC_API_BASE_URL=

# Obrigatória — URL HTTPS da Política de Privacidade publicada.
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Opcional — prefixo das chaves salvas no AsyncStorage (padrão: @meudentinho).
# EXPO_PUBLIC_LOCAL_STORAGE_KEY=@meudentinho
