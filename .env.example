# Obrigatória — URL base da API.
# Em desenvolvimento (expo start) pode ser http:// — no emulador use http://10.0.2.2:8080 e
# em device físico http://<IP-da-sua-máquina-na-rede>:8080.
# Em release o build só passa com https:// (validado por "npm run env:check -- --release").
EXPO_PUBLIC_API_BASE_URL=

API_PROXY_TARGET=

# Obrigatória — URL HTTPS da Política de Privacidade publicada (sempre https://).
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Opcional — prefixo das chaves salvas no AsyncStorage (padrão: @janelinha).
# EXPO_PUBLIC_LOCAL_STORAGE_KEY=@janelinha

# O Expo carrega apenas .env, .env.local e .env.<modo> (modo vem do NODE_ENV):
# desenvolvimento usa ".env" e release usa ".env.production" quando existir — arquivo local,
# gitignorado. Não existe ".env.preview". O EAS Build injeta as variáveis por perfil.
