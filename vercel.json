{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/politica-de-privacidade.html",
      "destination": "/politica-de-privacidade",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "$API_PROXY_TARGET/auth/:path*",
      "env": ["API_PROXY_TARGET"]
    },
    {
      "source": "/users/:path*",
      "destination": "$API_PROXY_TARGET/users/:path*",
      "env": ["API_PROXY_TARGET"]
    },
    {
      "source": "/articles/:path*",
      "destination": "$API_PROXY_TARGET/articles/:path*",
      "env": ["API_PROXY_TARGET"]
    },
    {
      "source": "/tooth-events/:path*",
      "destination": "$API_PROXY_TARGET/tooth-events/:path*",
      "env": ["API_PROXY_TARGET"]
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade.html"
    },
    {
      "source": "/app",
      "destination": "/app-shell.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/pwa/register.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/politica-de-privacidade",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app-shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
