{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/politica-de-privacidade.html",
      "destination": "/politica-de-privacidade",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade.html"
    },
    { "source": "/app", "destination": "/app-shell.html" },
    { "source": "/app/:path*", "destination": "/app-shell.html" }
  ],
  "headers": [
    {
      "source": "/politica-de-privacidade",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/app-shell.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
