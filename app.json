{
  "expo": {
    "name": "Janelinha",
    "slug": "janelinha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/new-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.janelinhaapp",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/new-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.janelinhaapp",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
