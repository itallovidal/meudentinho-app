{
  "expo": {
    "name": "Janelinha",
    "slug": "janelinha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tooth-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.janelinhaapp",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/tooth-icon.png",
        "backgroundColor": "#ffffff"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.janelinhaapp",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/tooth.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-status-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-tooth-wordmark.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "backgroundColor": "#ffffff"
  }
}
