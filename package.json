{
  "name": "janelinha-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "TZ=America/Sao_Paulo jest",
    "env:check": "node scripts/validate-env.js",
    "android": "expo run:android",
    "android:apk:preview": "npm run env:check -- --release && expo prebuild --clean && cd android && ./gradlew assembleRelease",
    "android:apk:preview:debug": "cd android && ./gradlew assembleDebug",
    "android:apk:install:preview": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:apk:install:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/elements": "^2.9.44",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@rn-primitives/dialog": "^1.4.0",
    "@rn-primitives/popover": "^1.4.0",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/separator": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@tanstack/react-query": "^5.100.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "^58.0.17",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-print": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "nativewind": "^4.2.3",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-hook-form": "^7.75.0",
    "react-native": "0.88.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-remark": "^1.0.5",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest-expo": "~58.0.12",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "private": true
}
